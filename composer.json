{
    "name": "sendrepute/laravel",
    "description": "Explicit, opt-in SendRepute email classification for Laravel",
    "type": "library",
    "license": "MIT",
    "homepage": "https://www.sendrepute.com",
    "support": {
        "email": "support@sendrepute.com",
        "issues": "https://github.com/sendrepute/sendrepute-laravel/issues",
        "source": "https://github.com/sendrepute/sendrepute-laravel"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/mail": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SendRepute\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SendRepute\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SendRepute\\Laravel\\SendReputeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests config -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}